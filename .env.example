# ===== LLM 供应商 =====
# 可选: ark(火山方舟) / deepseek / openai / ollama
LLM_PROVIDER=ark
LLM_MODEL=deepseek-v4.1-flash
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_TEMPERATURE=0.0

# Ark(火山方舟) 专用密钥，兼容 first_chat.py
ARK_API_KEY=

# ===== 向量库 =====
VECTOR_STORE_DIR=data/vector_db

# ===== 日志 =====
LOG_LEVEL=INFO

# ===== LangSmith 追踪(可选) =====
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain-learning
